{
  "name": "accommodations-tracker",
  "productName": "Bloom",
  "version": "1.0.1",
  "private": true,
  "description": "Offline daily IEP/504 accommodation tracking for teachers. Local JSON only, never touches the network.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && electron .",
    "dev:electron": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5180 && cross-env ACC_DEV_SERVER=http://localhost:5180 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:win": "npm run build && node scripts/electron-build-win.js",
    "smoke": "npm run build && electron scripts/smoke.js",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/share": "8.0.1",
    "@hello-pangea/dnd": "^18.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "sass": "^1.102.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.1"
  }
}
